APP_NAME=Metrix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL — the only supported DB driver for this project (see project CLAUDE.md)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=metrix
DB_USERNAME=metrix
DB_PASSWORD=metrix

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Local disk only — never point this at s3. Use "public" so files are
# browsable through the storage:link symlink.
FILESYSTEM_DISK=public

# database queue driver — no Redis, no external broker
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Local Python image-similarity microservice (FastAPI) — see /image-service.
# Called over the docker-compose network by service name, never the public internet.
IMAGE_SERVICE_URL=http://image-service:8001
IMAGE_SERVICE_SHARED_SECRET=change-me-shared-secret

# Comma-separated list of origins allowed to call this API (config/cors.php).
# The standalone React dashboard's dev server origin by default.
FRONTEND_ORIGIN=http://localhost:5173

# Shared secret the Mini App ingestion pipeline sends as the X-Ingestion-Key
# header. Change this before exposing the ingestion endpoint anywhere.
INGESTION_API_KEY=dev-ingestion-key-change-me
