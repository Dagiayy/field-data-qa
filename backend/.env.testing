APP_NAME=Metrix
APP_ENV=testing
APP_KEY=base64:ctBUV1IYcDvd+/XPUe8/oQ6QME2w8xuJyAn6zIA0LL8=
APP_DEBUG=true

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Isolated in-memory sqlite for the automated test suite — this file exists
# specifically so tests can NEVER resolve to the real Postgres database.
# phpunit.xml's <php><env ... force="true"> alone was not enough: PHPUnit's
# env overrides only reach getenv()/$_ENV, not $_SERVER, and Laravel's
# config resolution reads $_SERVER first — so without this file, the whole
# suite (including RefreshDatabase, which drops and rebuilds every table)
# silently ran against the real dev database and wiped it more than once.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=array
BROADCAST_CONNECTION=null
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

FILESYSTEM_DISK=local

IMAGE_SERVICE_URL=http://image-service:8001
IMAGE_SERVICE_SHARED_SECRET=test-secret

FRONTEND_ORIGIN=http://localhost:5173
INGESTION_API_KEY=test-ingestion-key
