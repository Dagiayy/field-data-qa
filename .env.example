# Root-level reference for the whole stack. docker-compose.yml reads a root
# `.env` (if present) to fill in the Postgres container's credentials; every
# other value below is authoritative in its own service's .env file
# (backend/.env.example, frontend/.env.example) — this file just gives you a
# single place to see every knob across the system.
#
# Copy to `.env` only if you want to override the Postgres defaults baked
# into docker-compose.yml (metrix/metrix/metrix) — it is optional otherwise.

# --- Postgres (used by docker-compose.yml for the postgres service) ---
DB_DATABASE=metrix
DB_USERNAME=metrix
DB_PASSWORD=metrix

# --- backend/.env (Laravel) ---
# APP_KEY=                        # generate with `php artisan key:generate`
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# QUEUE_CONNECTION=database       # database-backed queue, no Redis
# FILESYSTEM_DISK=public          # local disk only, never s3
# IMAGE_SERVICE_URL=http://image-service:8001
# IMAGE_SERVICE_SHARED_SECRET=change-me-shared-secret
# FRONTEND_ORIGIN=http://localhost:5173   # CORS allow-list, config/cors.php

# --- frontend/.env (Vite) ---
# VITE_API_BASE_URL=http://localhost:8000/api   # routes/api.php is auto-prefixed with /api
